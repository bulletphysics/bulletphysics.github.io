		<published>2006-09-21T19:06:52+00:00</published>
		<id>https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=1836#p1836</id>
		<link href="https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=1836#p1836"/>
