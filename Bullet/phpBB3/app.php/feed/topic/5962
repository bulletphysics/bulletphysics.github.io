		<author><name><![CDATA[VicariousEnt]]></name></author>
		<updated>2011-01-25T00:49:41+00:00</updated>

		<published>2011-01-25T00:49:41+00:00</published>
		<id>https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=21890#p21890</id>
		<link href="https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=21890#p21890"/>
