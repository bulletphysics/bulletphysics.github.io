		<author><name><![CDATA[Erwin Coumans]]></name></author>
		<updated>2006-01-07T21:37:37+00:00</updated>

		<published>2006-01-07T21:37:37+00:00</published>
		<id>https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=607#p607</id>
