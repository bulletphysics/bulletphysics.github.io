Nathanael said the algorithm is incremental convex hull,<br>but I can't find paper<br><br>btGjkEpa2.cpp:<br>EPA::Evaluate()<div class="codebox"><p>Code: </p><pre><code>m_status = eStatus::Valid;for (; iterations &lt; EPA_MAX_ITERATIONS; ++iterations){if (m_nextsv &lt; EPA_MAX_VERTICES){sHorizonhorizon;sSV*w = &amp;m_sv_store[m_nextsv++];boolvalid = true;best-&gt;pass = (U1)(++pass);gjk.getsupport(best-&gt;n, *w);const tbScalarwdist = dot(best-&gt;n, w-&gt;w) - best-&gt;d;if (wdist&gt;EPA_ACCURACY){for (U j = 0; (j &lt; 3) &amp;&amp; valid; ++j){valid &amp;= expand(pass, w,best-&gt;f[j], best-&gt;e[j],horizon);}       if (valid &amp;&amp; (horizon.nf &gt;= 3)){bind(horizon.cf, 1, horizon.ff, 2);remove(m_hull, best);append(m_stock, best);best = findbest();if (best-&gt;p &gt;= outer.p) outer = *best;}else { m_status = eStatus::InvalidHull; break; }}else { m_status = eStatus::AccuraryReached; break; }}else { m_status = eStatus::OutOfVertices; break; }}</code></pre></div><p>Statistics: Posted by <a href="https://pybullet.org/Bullet/phpBB3/memberlist.php?mode=viewprofile&amp;u=11805">Jack2016</a> — Fri Sep 09, 2016 3:54 am</p><hr />
