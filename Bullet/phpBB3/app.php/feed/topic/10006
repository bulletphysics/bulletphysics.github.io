		<updated>2022-09-05T03:06:36+00:00</updated>

		<published>2022-09-05T03:06:36+00:00</published>
		<id>https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=44106#p44106</id>
		<link href="https://pybullet.org/Bullet/phpBB3/viewtopic.php?p=44106#p44106"/>
