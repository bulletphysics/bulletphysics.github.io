		//Xcm += X[i]*mass * sumMinv;
		//Vcm += V[i]*mass * sumMinv;

		XcmK += X[i]*mass * sumMinv;
		VcmK += V[i]*mass * sumMinv;
		//sumM += mass;
	}
	glm::vec3 Xcm = XcmK.sum;
	glm::vec3 Vcm =	VcmK.sum;

	//Xcm /= sumM; 
