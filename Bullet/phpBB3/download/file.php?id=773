		const float mass = CalcMass(W[i]); //calc mass
		//sumM += mass;
		//using KahanSum >>>
		const float y = mass - sumMc; 
		const float temp = sumM + y;
		sumMc = (temp - sumM) - y;
		sumM = temp;
	}
