<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Bullet/phpBB3/

    # 1. If a request is for viewtopic.php?t=XYZ, check if the encoded static file exists on disk
    RewriteCond %{QUERY_STRING} ^t=([0-9]+)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/Bullet/phpBB3/viewtopic.php%3Ft=%1.html -f
    RewriteRule ^viewtopic\.php$ viewtopic.php%3Ft=%1.html [L]

    # 2. If the static file does NOT exist on disk (deleted/ghost topic), route to our error handler script
    RewriteCond %{QUERY_STRING} ^t=([0-9]+)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^viewtopic\.php$ missing_topic.php?t=%1 [L]
</IfModule>

